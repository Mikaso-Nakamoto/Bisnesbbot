# Настрой хотя бы один канал. VK — основной для клиентов.
# Настоящий .env не коммитить и не отправлять в чаты.

# Telegram — дополнительный канал. Оставь пустым, если пока не подключён.
BOT_TOKEN=
ADMIN_TELEGRAM_IDS=

# VK: ключ доступа сообщества (не личный токен) и числовой ID сообщества.
# VK Bots Long Poll API должен быть включён в настройках сообщества.
VK_GROUP_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199
VK_ADMIN_USER_IDS=

# MAX Bot API — отдельный бот для копий уведомлений тёте; не VK API.
# MAX-бот должен быть создан/настроен отдельно, тётя должна открыть с ним диалог.
MAX_BOT_TOKEN=
MAX_ADMIN_USER_IDS=

# Путь к единственной общей базе SQLite на ноутбуке.
DB_PATH=data/bisnesbbot.sqlite3

# ВРЕМЕННОЕ значение. Перед реальным запуском заменить на часовой пояс тёти.
TIMEZONE=Europe/Moscow

SERVICE_NAME=Массаж
SERVICE_DURATION_MINUTES=60
BUFFER_MINUTES=0
BOOKING_DAYS_AHEAD=14

# ДЕМО-РАСПИСАНИЕ, не расписание тёти:
# 0 = понедельник ... 6 = воскресенье.
# Пока DEMO_MODE=true, бот явно предупреждает клиентов, что график условный.
DEMO_MODE=true
WEEKLY_SCHEDULE_JSON='{"0":[["10:00","18:00"]],"1":[["10:00","18:00"]],"2":[["10:00","18:00"]],"3":[["10:00","18:00"]],"4":[["10:00","18:00"]],"5":[["10:00","14:00"]],"6":[]}'
